// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  image         String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  config        UserConfig?
  results       AnalysisResult[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserConfig {
  id                    String   @id @default(cuid())
  userId                String   @unique
  
  // LLM Configuration
  llmProvider           String   @default("openai")
  deepThinkLLM          String   @default("gpt-4o-mini")
  quickThinkLLM         String   @default("gpt-4o-mini")
  backendUrl            String?
  
  // Debate Configuration
  maxDebateRounds       Int      @default(1)
  maxRiskDiscussRounds  Int      @default(1)
  
  // Data Vendor Configuration
  coreStockApis         String   @default("yfinance")
  technicalIndicators   String   @default("yfinance")
  fundamentalData       String   @default("alpha_vantage")
  newsData              String   @default("alpha_vantage")
  
  // Tool Overrides (JSON)
  toolVendors           Json?
  
  // API Keys (encrypted)
  openaiApiKey          String?
  alphaVantageApiKey    String?
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AnalysisResult {
  id                    String   @id @default(cuid())
  userId                String
  ticker                String
  date                  String
  
  // Configuration used
  config                Json
  
  // Full state (JSON)
  state                 Json
  
  // Final decision
  decision              String   // BUY, SELL, HOLD
  
  // Timing
  createdAt             DateTime @default(now())
  completedAt           DateTime?
  duration              Int?     // milliseconds
  
  // Status
  status                String   @default("pending") // pending, processing, completed, failed
  error                 String?  @db.Text
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([ticker])
  @@index([date])
  @@index([createdAt])
}
